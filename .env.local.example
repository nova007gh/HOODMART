# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EMDPOS Retail OS

# Development
NODE_ENV=development

# Eganow Payment Gateway (https://docs.sandbox.egacoreapi.com/)
EGANOW_BASE_URL=https://developer.sandbox.egacoreapi.com
EGANOW_SECRET_USERNAME=your_eganow_secret_username
EGANOW_SECRET_PASSWORD=your_eganow_secret_password
EGANOW_X_AUTH=your_eganow_x_auth
